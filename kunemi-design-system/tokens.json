{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Single source of truth for Kunemi's extracted design tokens. Source-derived colors are mapped to the required semantic roles; dark values are derived because the source site defines a light theme plus dark-section colors, not a complete dark mode.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#faf8f5", "$description": "Warm mineral page background." },
      "foreground": { "$value": "#192420", "$description": "Deep green-black text." },
      "border": { "$value": "#d4ded9", "$description": "Soft mineral border." },
      "card": { "$value": "#faf8f5" },
      "cardForeground": { "$value": "#192420" },
      "popover": { "$value": "#faf8f5" },
      "popoverForeground": { "$value": "#192420" },
      "primary": { "$value": "#236b48", "$description": "Kunemi forest green for primary actions and emphasis." },
      "primaryForeground": { "$value": "#f7f7ef" },
      "secondary": { "$value": "#e4ece7", "$description": "Pale green mineral surface." },
      "secondaryForeground": { "$value": "#192420" },
      "muted": { "$value": "#e7eeea" },
      "mutedForeground": { "$value": "#63746d" },
      "accent": { "$value": "#182823", "$description": "The deep forest surface used for footer and dark sections." },
      "accentForeground": { "$value": "#eff3e9" },
      "destructive": { "$value": "#c52626" },
      "destructiveForeground": { "$value": "#faf8f5" },
      "input": { "$value": "#cbd7d1" },
      "ring": { "$value": "#236b48" },
      "chart1": { "$value": "#43815a", "$description": "Dotrix green." },
      "chart2": { "$value": "#d18b4b", "$description": "Shopflow warm amber." },
      "chart3": { "$value": "#85789b", "$description": "Commerce muted violet." },
      "chart4": { "$value": "#7696a0", "$description": "Kumove slate blue." },
      "chart5": { "$value": "#ce6555", "$description": "Warm signal coral." },
      "sidebar": { "$value": "#f8f8f3" },
      "sidebarForeground": { "$value": "#526359" },
      "sidebarBorder": { "$value": "#d4ded9" },
      "sidebarPrimary": { "$value": "#236b48" },
      "sidebarPrimaryForeground": { "$value": "#f7f7ef" },
      "sidebarAccent": { "$value": "#e4ece7" },
      "sidebarAccentForeground": { "$value": "#192420" },
      "sidebarRing": { "$value": "#236b48" }
    },
    "dark": {
      "background": { "$value": "#151e1b", "$description": "Derived dark forest base; the source has no full dark mode." },
      "foreground": { "$value": "#eff3e9" },
      "border": { "$value": "#384741" },
      "card": { "$value": "#1c2623" },
      "cardForeground": { "$value": "#eff3e9" },
      "popover": { "$value": "#1c2623" },
      "popoverForeground": { "$value": "#eff3e9" },
      "primary": { "$value": "#83b18f", "$description": "Lightened Kunemi green for contrast on dark surfaces." },
      "primaryForeground": { "$value": "#151e1b" },
      "secondary": { "$value": "#313f39" },
      "secondaryForeground": { "$value": "#eff3e9" },
      "muted": { "$value": "#313f39" },
      "mutedForeground": { "$value": "#aebdb1" },
      "accent": { "$value": "#24372d" },
      "accentForeground": { "$value": "#eff3e9" },
      "destructive": { "$value": "#d33131" },
      "destructiveForeground": { "$value": "#151e1b" },
      "input": { "$value": "#384741" },
      "ring": { "$value": "#83b18f" },
      "chart1": { "$value": "#9ac5a3" },
      "chart2": { "$value": "#d7b37e" },
      "chart3": { "$value": "#b4a7c8" },
      "chart4": { "$value": "#9db8c0" },
      "chart5": { "$value": "#e18b78" },
      "sidebar": { "$value": "#182823" },
      "sidebarForeground": { "$value": "#d5e0d6" },
      "sidebarBorder": { "$value": "#384741" },
      "sidebarPrimary": { "$value": "#83b18f" },
      "sidebarPrimaryForeground": { "$value": "#151e1b" },
      "sidebarAccent": { "$value": "#24372d" },
      "sidebarAccentForeground": { "$value": "#eff3e9" },
      "sidebarRing": { "$value": "#83b18f" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Source website's heading and body family."
      },
      "serif": {
        "$value": ["Georgia", "serif"],
        "$description": "Schema fallback only; the source site does not use a serif family."
      },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "Source website's uppercase labels, category markers, and technical annotations."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base, matching the source's button corner radius; cards are square-cornered."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base step observed across the source's compact spacing values."
    }
  }
}
